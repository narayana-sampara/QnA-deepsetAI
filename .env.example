# Required: clients must send this value in the X-API-Key header.
QNA_API_KEY=Mango-Giraffe-Penguin-Xylophone

# Required: Hugging Face access token used to call the Inference API.
HF_TOKEN=hf_your_token_here

# Optional: override the QA model served via the HF Inference API.
HF_QA_MODEL=deepset/roberta-base-squad2

# Comma-separated list of allowed CORS origins (no wildcard in production).
QNA_ALLOWED_ORIGINS=https://your-frontend.example.com

# Comma-separated list of allowed Host headers (no wildcard in production).
QNA_ALLOWED_HOSTS=api.example.com

# slowapi rate limit expression, e.g. "20/minute", "100/hour"
QNA_RATE_LIMIT=20/minute

# Max characters accepted in the "question" field
QNA_MAX_QUESTION_LENGTH=300

QNA_LOG_LEVEL=INFO
